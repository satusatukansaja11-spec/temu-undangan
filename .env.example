PORT=3000
APP_URL=http://localhost:3000
DATA_DIR=./data
# Hanya untuk pengujian lokal, dinonaktifkan otomatis dalam production.
DEMO_LOGIN=false
NODE_ENV=development

# Sign in with Apple: domain HTTPS, Services ID, Team ID dan key .p8 dari Apple Developer.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Gunakan secret server. Baris baru dapat disimpan sebagai karakter literal \n.
APPLE_PRIVATE_KEY=

# Kosong = SQLite untuk localhost. Isi URL PostgreSQL untuk hosting.
DATABASE_URL=
REQUIRE_POSTGRES=false
AUTO_MIGRATE=true
DB_POOL_SIZE=10
# Aktifkan untuk PostgreSQL remote; sertifikat tetap diverifikasi.
PG_SSL=false
PG_CA_FILE=
# Jumlah reverse proxy yang benar-benar dipercaya, 0 jika tanpa proxy.
TRUST_PROXY=0

# local membutuhkan disk/volume persisten. s3 menggunakan bucket privat.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
MAX_GALLERY_PHOTOS=200
MAX_EVENT_PHOTOS=1000
MAX_IMAGE_MB=10
MAX_AUDIO_MB=30
MAX_EVENT_STORAGE_MB=2048
MAX_EVENT_TRACKS=20

# Hanya untuk compose.yaml; gunakan password acak berbentuk hex.
POSTGRES_DB=temu
POSTGRES_USER=temu
POSTGRES_PASSWORD=
