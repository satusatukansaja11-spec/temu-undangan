{
  "name": "temu-undangan",
  "version": "1.0.0",
  "description": "Aplikasi undangan pernikahan digital berbahasa Indonesia",
  "main": "server.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "test": "node --test test/*.test.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:import-sqlite": "node --env-file-if-exists=.env scripts/import-sqlite.js",
    "storage:sync": "node --env-file-if-exists=.env scripts/storage-maintenance.js sync",
    "media:backfill": "node --env-file-if-exists=.env scripts/storage-maintenance.js backfill",
    "storage:cleanup": "node --env-file-if-exists=.env scripts/storage-maintenance.js cleanup",
    "admin:grant": "node --env-file-if-exists=.env scripts/admin-access.js grant",
    "admin:revoke": "node --env-file-if-exists=.env scripts/admin-access.js revoke"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "music-metadata": "^12.3.4",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "body-parser": "^2.4.0"
  }
}
